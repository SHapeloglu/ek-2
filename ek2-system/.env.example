APP_NAME="EK-2 Sistemi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ek-2.selimkilic.com.tr

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql-ortak
DB_PORT=3306
DB_DATABASE=ek2_system
DB_USERNAME=uygulama
DB_PASSWORD=CHANGE_ME

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# OCR aktarım klasörü (konteyner içi yol); docker-compose bunu sunucudaki OCR_AKTARIM_HOST klasörüne bağlar
OCR_AKTARIM_DIZINI=/var/www/html/storage/ocr_aktarim
OCR_AKTARIM_HOST=./ocr_aktarim
# Tüm EK-2 fotoğrafları tek yerde (sunucu yolu); OCR'a bu yola işaret eden bağlar gider
BELGE_HOST_DIZINI=/srv/ek2/belgeler

ADMIN_NAME=System
ADMIN_SURNAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_NOW

# EK-2 kalite kontrol servisi (fotoğraf okunabilirlik/hizalama); boş = kontrol kapalı
EK2_HIZALAMA_URL=
